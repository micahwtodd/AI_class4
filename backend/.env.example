# Copy to .env (never commit .env). The backend reads these at startup and on each chat.

# Your Portkey API key (from app.portkey.ai > API Keys)
PORTKEY_API_KEY=paste-your-portkey-key-here

# Model and gateway
MODEL=gpt-6-luna
PORTKEY_BASE_URL=https://api.portkey.ai/v1

# Optional: only if your Portkey key needs them to route to OpenAI
PORTKEY_PROVIDER=
PORTKEY_VIRTUAL_KEY=
PORTKEY_CONFIG=
